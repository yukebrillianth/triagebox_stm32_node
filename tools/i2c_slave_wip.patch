+/* How long the slave may look wedged before tb_slave_service() re-inits it.
+ * Longer than the ESP32's 50 ms poll and than any single transaction (the
+ * 132-byte PPG read is ~13 ms at 100 kHz), short enough that a jam clears
+ * before the ESP32 finishes booting and gives up on the bus. */
+#define TB_SLAVE_STUCK_MS 1000U
+
+/* Last tick at which the slave was armed and listening. */
+static uint32_t s_healthy_ms = 0;
+
+/*
+ * Set when re-arming the slave failed even after the forced path in
+ * rearm_listen(), cleared by bus_reinit(). This is the only evidence
+ * tb_slave_service() can act on for the family of faults where the slave is left
+ * not listening while State still reads LISTEN.
+ *
+ * HAL_I2C_EnableListen_IT() only accepts HAL_I2C_STATE_READY and returns
+ * HAL_BUSY from anything else -- and I2C_ITError() deliberately KEEPS
+ * State = LISTEN whenever the LISTEN bit is set. So on every error path that
+ * routes through I2C_ITError() (STOPF with bytes still outstanding, and anything
+ * with a bus or overrun error), a bare re-arm is refused. Both call sites used to
+ * throw the result away with (void), so the refusal was invisible.
+ *
+ * A refused re-arm is not cosmetic: I2C_Slave_STOPF() has already done
+ * __HAL_I2C_DISABLE_IT(EVT|BUF|ERR) and I2C_Slave_AF() may have cleared
+ * I2C_CR1_ACK, while PE stays set. An enabled slave with no interrupts sets ADDR
+ * in hardware on the next address match with nothing to clear it -- SCL low
+ * forever, taking the ESP32's touch/expander/PMIC bus down with it. State reads
+ * LISTEN throughout, so the state test in tb_slave_service() calls it healthy.
+ */
+static volatile bool s_rearm_failed = false;
+
+/*
+ * Re-arm listening, and if the HAL refuses, take the state back by force.
+ *
+ * The plain HAL_I2C_EnableListen_IT() only accepts HAL_I2C_STATE_READY. On the
+ * refused path the state is LISTEN, and HAL_I2C_DisableListen_IT() accepts
+ * exactly that and yields READY -- so the documented way out is the
+ * Disable/Enable pair, not Enable alone.
+ *
+ * The PE toggle in between is not cosmetic. An aborted slave transmit leaves a
+ * byte sitting in DR with TXE reset, and I2C_Slave_AF() only calls
+ * I2C_Flush_DR() on the branch it does not take here. Left there, that byte is
+ * shifted out as the FIRST byte of the next read, which the master then decodes
+ * as proto_ver. Clearing PE resets the peripheral's state machine and empties DR
+ * without touching OAR1/CCR/CR2, and EnableListen sets PE again on its way past.
+ *
+ * s_rearm_failed is only set if even that fails, which leaves the superloop to
+ * do a full bus_reinit().
+ */
+static void rearm_listen(I2C_HandleTypeDef *hi2c)
+{
+    if (HAL_I2C_EnableListen_IT(hi2c) == HAL_OK) {
+        return;
+    }
+    if (HAL_I2C_DisableListen_IT(hi2c) == HAL_OK) {
+        __HAL_I2C_DISABLE(hi2c);
+        if (HAL_I2C_EnableListen_IT(hi2c) == HAL_OK) {
+            ++mon_i2c_rearm_forced;
+            return;
+        }
+    }
+    s_rearm_failed = true;
+}
 
