+void tb_slave_init(void)
+{
+    memset(&s_stage, 0, sizeof(s_stage));
+    s_stage.proto_ver = TB_PROTO_VER;
+    s_stage.battery = 0xFFU; /* not measured */
+
+    /* 0xFF everywhere first, so every gap in the map -- the write block, the
+     * hole between 0x43 and 0x50, everything past the waveform -- reads back as
+     * "nothing here" instead of whatever was in RAM. The two memcpys below only
+     * ever overwrite the parts that mean something. */
+    memset(s_tx, 0xFF, sizeof(s_tx));
+
+    memcpy((void *)&s_live, &s_stage, sizeof(s_stage));
+    memcpy(s_tx, &s_stage, sizeof(s_stage));
+
+    memset((void *)&s_ppg, 0, sizeof(s_ppg));
+    memset(&s_tx[TB_REG_PPG_BASE], 0, sizeof(tb_ppg_block_t));
+
+    s_ptr = 0U;
+    s_ptr_valid = false;
+    s_healthy_ms = HAL_GetTick();
+
+    /* CubeMX leaves OwnAddress1 at 0, so set it and re-init -- see bus_reinit(),
+     * which the watchdog below also uses. */
+    bus_reinit();
+}
+
+/*
+ * Is the peripheral DEAF: enabled, so it will ACK its address and then stretch
+ * SCL, but with the interrupts that would service the match switched off?
+ *
+ * This is a register test, not a HAL-state test, and that is the entire point.
+ * Every wedge in this file's history has had the same shape -- some HAL path
+ * disabled EVT|ERR and left PE set -- and every attempt to catch it by asking
+ * hi2c2.State has failed, because the paths that do it also leave State reading
+ * LISTEN (I2C_ITError keeps LISTEN; I2C_SlaveTransmit_TXE sets it early). CR1 and
+ * CR2 cannot lie: if PE is set and ITEVTEN is clear, the next address match sets
+ * ADDR in hardware with nothing to clear it, and SCL goes to the floor and stays
+ * there -- along with the ESP32's touch controller, IO expander and PMIC.
+ *
+ * Read once, no side effects, safe to call from the superloop at any time.
+ */
+static bool slave_is_deaf(void)
+{
+    uint32_t cr1 = hi2c2.Instance->CR1;
+    uint32_t cr2 = hi2c2.Instance->CR2;
+
+    return ((cr1 & I2C_CR1_PE) != 0U) &&
+           ((cr2 & (I2C_CR2_ITEVTEN | I2C_CR2_ITERREN)) !=
+            (I2C_CR2_ITEVTEN | I2C_CR2_ITERREN));
+}
+
+/*
+ * Watchdog for a wedged slave. Call from the superloop.
+ *
+ * Healthy means one exact thing: HAL state LISTEN -- armed, between
+ * transactions. Every other state is legal only in passing, so anything that
+ * persists for TB_SLAVE_STUCK_MS is a wedge:
+ *
+ *  - Stuck mid-transfer (BUSY_TX_LISTEN / BUSY_RX_LISTEN), holding SCL low and so
+ *    taking the ESP32's touch/expander/PMIC bus down with it.
+ *  - Listening lost (READY). If EnableListen_IT fails to re-arm on an error path,
+ *    the slave goes quiet for good.
+ *  - Re-arm REFUSED (s_rearm_failed), which State cannot show. Every error path
+ *    through I2C_ITError() keeps State = LISTEN while EnableListen_IT only accepts
+ *    READY, so the slave can be left with EVT|BUF|ERR disabled and ACK cleared
+ *    while looking perfectly armed. That combination stretches SCL forever on the
+ *    next address match. See s_rearm_failed.
+ *
+ * WHAT THIS STILL CANNOT SEE, so do not read mon_i2c_recoveries == 0 as "the bus
+ * is fine": a transmit under-run where the master keeps clocking past the armed
+ * length. I2C_SlaveTransmit_TXE() sets State back to LISTEN as soon as the last
+ * armed byte reaches DR, so this function refreshes s_healthy_ms every pass while
+ * SCL is on the floor, and no error path has run yet to set s_rearm_failed. There
+ * is no state to test for. The mitigation is upstream, at the arm site: arm each
+ * block's exact length so the ordinary read is on the HAL's clean path, and keep
+ * the ESP32's read length equal to the block length.
+ *
+ * SR2's BUSY flag is deliberately NOT part of the test. It tracks the bus, not
+ * us -- it sets on any START, including the ESP32 talking to the touch
+ * controller -- and it does not gate slave operation, only master mode. Testing
+ * it would risk re-initialising a perfectly healthy slave because of someone
+ * else's traffic.
+ *
+ * The threshold is safe against false positives: the longest legitimate
+ * transaction is the 132-byte PPG read at ~13 ms, and the superloop runs every
+ * ~10 ms, so it sees idle LISTEN many times between the ESP32's 50 ms polls.
+ *
+ * Recovery is DeInit/Init/EnableListen, which releases SDA and SCL because
+ * MspDeInit puts the pins back to analog. Published data survives untouched.
+ *
+ * ponytail: ceiling is that this only fixes the case where WE hold the bus. If
+ * the ESP32 side is the one stuck low, the STM32 cannot clear it -- that needs
+ * the nine-clock master recovery pulse on PB10, which means temporarily driving
+ * SCL as GPIO. Add it if mon_i2c_recoveries climbs but the panel stays white.
+ */
+void tb_slave_service(void)
+{
+    uint32_t now = HAL_GetTick();
+
+    /* Checked before the state test, because this is the case State lies about:
+     * it reads LISTEN while the interrupts are off. Recover at once -- waiting
+     * TB_SLAVE_STUCK_MS would just be a second of held bus. */
+    if (s_rearm_failed) {
+        ++mon_i2c_recoveries;
+        bus_reinit();
+        s_healthy_ms = now;
+        return;
+    }
+
+    if (HAL_I2C_GetState(&hi2c2) == HAL_I2C_STATE_LISTEN) {
+        s_healthy_ms = now;
+        return;
+    }
+
+    if ((now - s_healthy_ms) < TB_SLAVE_STUCK_MS) {
+        return; /* mid-transaction; let it finish normally */
+    }
+
+    ++mon_i2c_recoveries;
+    bus_reinit();
+    s_healthy_ms = now;
+}
