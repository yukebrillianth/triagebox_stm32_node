# STM32CubeIDE build output. Regenerated by every build; the .map/.elf are huge
# and change on every compile, so they would swamp any real diff.
/Debug/
/Release/

# CubeIDE indexer / local workspace state (per-machine, not per-project).
.settings/
*.launch

# CubeMX keeps this as a cache of what it last generated. It records absolute
# paths from this machine, so it does not travel.
.mxproject
